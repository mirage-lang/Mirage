// Open flags. These DO match Linux's values (emscripten's musl keeps the asm-generic
// numbering here), unlike the errno codes next door — but they are spelled out rather
// than shared so the two backends stay independently checkable.
pub const O_RDONLY      := 0
pub const O_WRONLY      := 1
pub const O_RDWR        := 2

pub const O_CREAT       := 0o00000100
pub const O_EXCL        := 0o00000200
pub const O_NOCTTY      := 0o00000400
pub const O_TRUNC       := 0o00001000
pub const O_APPEND      := 0o00002000
pub const O_NONBLOCK    := 0o00004000
pub const O_DSYNC       := 0o00010000
pub const O_DIRECTORY   := 0o00200000
pub const O_NOFOLLOW    := 0o00400000
pub const O_CLOEXEC     := 0o02000000
pub const O_SYNC        := 0o04000000 | O_DSYNC

pub const F_GETFL       := 3
pub const F_SETFL       := 4
