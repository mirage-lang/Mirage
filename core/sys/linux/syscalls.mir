const sys_read: i64       = 0
const sys_write: i64      = 1
const sys_open: i64       = 2
const sys_close: i64      = 3
const sys_lseek: i64      = 8
const sys_exit: i64       = 60
const sys_exit_group: i64 = 231

pub fn read(fd: Fd, buf: *u8, count: usize) -> i64 {
    return asm -> rax: i64 {
        mov rax, sys_read
        mov edi, fd
        mov rsi, buf
        mov rdx, count
        syscall
    }
}

pub fn write(fd: Fd, buf: *u8, count: usize) -> i64 {
    return asm -> rax: i64 {
        mov rax, sys_write
        mov edi, fd
        mov rsi, buf
        mov rdx, count
        syscall
    }
}

pub fn open(filename: *u8, flags: i32, mode: i32) -> i64 {
    return asm -> rax: i64 {
        mov rax, sys_open
        mov rdi, filename
        mov esi, flags
        mov edx, mode
        syscall
    }
}

pub fn close(fd: Fd) -> i64 {
    return asm -> rax: i64 {
        mov rax, sys_close
        mov edi, fd
        syscall
    }
}

pub fn lseek(fd: Fd, offset: i64, whence: i32) -> i64 {
    return asm -> rax: i64 {
        mov rax, sys_lseek
        mov rsi, offset
        mov edx, whence
        syscall
    }
}

@no_return
pub fn exit(error_code: i32) {
    asm {
        mov rax, sys_exit
        mov edi, error_code
        syscall
    }
}

@no_return
pub fn exit_group(error_code: i32) {
    asm {
        mov rax, sys_exit_group
        mov edi, error_code
        syscall
    }
}
