pub type IO_Error = error(IO_Error_Kind)
pub type IO_Error_Kind = enum {
    Invalid_Path      // Indicates that the provided path is invalid (it is empty or malformed)
    Invalid_Argument  // Indicates that one or more arguments passed to the operation are invalid
    Not_Exist         // Indicates that the requested file does not exist
    Permission_Denied // Indicates that the current process does not have sufficient permissions to perform the requested operation
    Would_Block       // Indicates that the operation could not be completed immediately and would block
    Closed            // Indicates that the file handle has been closed
    Interrupted       // Indicates that the operation was interupted before it could complete
    Unknown           // Indicates that an unexpected or otherwise unclassified error occurred
    Eof               // Indicates that the end of file was reached
    Unsupported       // Indicates that the operation cannot exist on this platform at all
}

pub type Seek_From = enum(u8) {
    Start
    Current
    End
}

pub type Reader = trait {
    fn read(self, dst: []u8) -> (usize, ?IO_Error)
}

pub type Writer = trait {
    fn write(self, src: []byte) -> (usize, ?IO_Error)
}

pub type Stream = trait(Reader, Writer)

pub type Seekable = trait {
    fn seek(self, offset: i64, whence: Seek_From) -> (i64, ?IO_Error)
    fn current(self) -> (i64, ?IO_Error)
}
