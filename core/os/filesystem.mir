#import("core/buffer")
#import("core/collections/list")
#import("core/io")
#import("core/string")

pub type Directory_Entry = struct {
    name: String
    is_directory: bool
    is_regular: bool
}

pub fn read_file(path: []u8, allocator := heap_allocator()) -> (Byte_Buffer, ?error(File_Error | Byte_Buffer_Error)) {
    const file := try open(path, {.Read})

    defer file.destroy()

    return_ok try read_all_bytes(file, allocator)
}

pub fn write_file(path: []u8, bytes: []u8) -> ?File_Error {
    mut file := try create(path)

    defer file.destroy()

    try write_all_bytes(file, bytes)
    try file.close()

    return_ok
}

pub fn create_empty_file(path: []u8) -> ?File_Error {
    return write_file(path, "")
}

pub fn append_line(path: []u8, bytes: []u8) -> ?File_Error {
    mut file := try open(path, {.Write, .Create, .Append})
    defer file.destroy()

    try write_all_bytes(file, bytes)
    try write_all_bytes(file, "\n")
    try file.close()
    
    return_ok
}

pub fn create_directory(path: []u8, allocator := heap_allocator()) -> ?error(IO_Error | String_Error) {
    if len(path) == 0 { 
        return_err .Invalid_Path 
    }

    mut owned := try make_string_from_bytes(path, allocator)
    defer owned.destroy()

    try _create_directory(owned.as_cstr())

    return_ok
}

pub fn exists(path: []u8, allocator := heap_allocator()) -> (bool, ?error(IO_Error | String_Error)) {
    if len(path) == 0 { 
        return_ok false 
    }

    mut owned := try make_string_from_bytes(path, allocator)
    defer owned.destroy()

    return_ok try _exists(owned.as_cstr())
}

pub fn is_directory(path: []u8, allocator := heap_allocator()) -> (bool, ?error(IO_Error | String_Error)) {
    if len(path) == 0 { 
        return_ok false 
    }
    
    mut owned := try make_string_from_bytes(path, allocator)
    defer owned.destroy()

    return_ok try _is_directory(owned.as_cstr())
}

pub fn is_file(path: []u8, allocator := heap_allocator()) -> (bool, ?error(IO_Error | String_Error)) {
    const present := try exists(path, allocator)
    if !present { 
        return_ok false 
    }

    return_ok !(try is_directory(path, allocator))
}

pub fn current_working_directory(allocator := heap_allocator()) -> (String, ?error(IO_Error | String_Error)) {
    return _current_working_directory(allocator)
}

pub fn write_file_atomic(path: []u8, bytes: []u8, allocator := heap_allocator()) -> ?error(IO_Error | String_Error) {
    return _write_file_atomic(path, bytes, allocator)
}

pub fn canonicalize(path: []u8, allocator := heap_allocator()) -> (String, ?error(IO_Error | String_Error)) {
    return _canonicalize(path, allocator)
}

pub fn list_directory(path: []u8, allocator := heap_allocator()) -> (List[Directory_Entry], ?error(IO_Error | List_Error | String_Error)) {
    return _list_directory(path, allocator)
}

pub fn make_temporary_file(prefix: []u8, allocator := heap_allocator()) -> (String, ?error(IO_Error | String_Error)) {
    return _make_temporary_file(prefix, allocator)
}

pub fn destroy_directory_entries(entries: *List[Directory_Entry]) {
    for index in ..entries.length {
        entries.data[index].name.destroy()
    }

    entries.destroy()
}
