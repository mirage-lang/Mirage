#compile_only_if(options.target_os == .Linux)

#import("build/options") as options

#import("core/buffer")
#import("core/collections/list")
#import("core/io")
#import("core/string")

pub type Directory_Entry = struct {
    name: String
    is_directory: bool
    is_regular: bool
}

pub fn read_file(path: []u8, allocator := heap_allocator()) -> (Byte_Buffer, ?error(File_Error | Byte_Buffer_Error)) {
    const file := try open(path, {.Read})

    defer file.destroy()

    return_ok try read_all_bytes(file, allocator)
}

pub fn write_file(path: []u8, bytes: []u8) -> ?File_Error {
    mut file := try create(path)

    defer file.destroy()

    try write_all_bytes(file, bytes)
    try file.close()

    return_ok
}

pub fn write_file_atomic(path: []u8, bytes: []u8, allocator := heap_allocator()) -> ?error(IO_Error | String_Error) {
    mut destination := try make_string_from_bytes(path, allocator)
    defer destination.destroy()

    mut temporary := try make_string_from_bytes(path, allocator)
    defer temporary.destroy()

    try temporary.append_bytes(".tmp.XXXXXX")

    const fd := mkstemp(temporary.as_cstr())
    if fd < 0 {
        return_err .Unknown
    }

    close(fd)

    const write_err := write_file(temporary.as_bytes(), bytes)
    if write_err {
        unlink(temporary.as_cstr())
        return_err write_err
    }

    if rename(temporary.as_cstr(), destination.as_cstr()) != 0 {
        unlink(temporary.as_cstr())
        return_err .Unknown
    }

    return_ok
}

pub fn canonicalize(path: []u8, allocator := heap_allocator()) -> (String, ?error(IO_Error | String_Error)) {
    mut input := try make_string_from_bytes(path, allocator)
    defer {
        input.destroy()
    }

    const resolved := realpath(input.as_cstr(), nil)
    if resolved == nil {
        return_err .Not_Exist
    }

    defer free(resolved)

    return_ok try make_string_from_bytes(cast(resolved, []u8, cstr_len(resolved)), allocator)
}

fn entry_name(entry: *Dirent) -> []u8 {
    mut length: usize = 0
    while length < 256 && entry.name[length] != 0 {
        length++
    }

    return entry.name[..length]
}

macro is_dot(name: []u8) -> 
    (len(name) == 1 && name[0] == '.') || 
    (len(name) == 2 && name[0] == '.' && name[1] == '.')

pub fn list_directory(path: []u8, allocator := heap_allocator()) -> (List[Directory_Entry], ?error(IO_Error | List_Error | String_Error)) {
    mut input := try make_string_from_bytes(path, allocator)
    defer {
        input.destroy()
    }

    const directory := opendir(input.as_cstr())
    if directory == nil {
        return_err .Not_Exist
    }

    defer closedir(directory)

    mut entries := make_list[Directory_Entry](allocator)
    while true {
        const raw := readdir(directory)
        if raw == nil {
            break
        }

        const name := entry_name(raw)
        if is_dot(name) {
            continue
        }

        const owned, owned_err := make_string_from_bytes(name, allocator)
        if owned_err {
            destroy_directory_entries(&entries)
            return_err owned_err
        }
        const err := entries.push({
            .name = owned,
            .is_directory = raw.entry_type == 4,
            .is_regular = raw.entry_type == 8,
        })

        if err {
            owned.destroy()
            destroy_directory_entries(&entries)
            return_err err
        }
    }

    return_ok entries
}

pub fn destroy_directory_entries(entries: *List[Directory_Entry]) {
    for index in ..entries.length {
        entries.data[index].name.destroy()
    }

    entries.destroy()
}

pub fn make_temporary_file(prefix: []u8, allocator := heap_allocator()) -> (String, ?error(IO_Error | String_Error)) {
    const path := try make_string_from_bytes(prefix, allocator)

    const append_err := path.append_bytes("XXXXXX")
    if append_err {
        path.destroy()
        return_err append_err
    }

    const fd := mkstemp(path.as_cstr())
    if fd < 0 {
        path.destroy()
        return_err .Unknown
    }

    close(fd)

    return_ok path
}
