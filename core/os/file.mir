pub type File_Error = error(IO_Error_Kind | Allocator_Error_Kind)

pub type File = trait(Stream, Seekable, Destructable) {
    // Returns the size of the file
    fn size(self) -> (usize, IO_Error)

    // Closes the file
    fn close(self) -> IO_Error
}

pub type File_Flags = bitset(File_Flag, u16)
pub type File_Flag = enum {
    Read
    Write
    Create
    Truncate
    Append
    Sync
    Non_Blocking
    Exclusive
}

pub type File_Whence = enum(i32) {
    Start
    Current
    End
}

pub mut stdin:  File = default
pub mut stdout: File = default
pub mut stderr: File = default

pub fn create(name: []u8) -> (File, File_Error) {
    return open(name, {.Read, .Write, .Create, .Truncate})
}

pub fn open(name: []u8, flags: File_Flags) -> (File, File_Error) {
    const file, err := _open(name, flags)
    if err {
        return_err err
    }

    return_ok file
}
