#compile_only_if(options.target_os == .Wasm32)

// The wasm/emscripten File backend. Structurally a mirror of file_linux.mir — same
// shape, same flag translation, same errno-to-IO_Error mapping — over core/sys/wasm,
// which presents emscripten's libc under the same -errno return convention.
//
// The filesystem underneath is emscripten's, not the host's: paths resolve inside the
// virtual filesystem the page was linked with (--preload-file / --embed-file assets,
// plus whatever the runtime mounts), and there is nothing else to open.
#import("build/options") as options

#import("core/sys/wasm") as wasm
#import("core/io")

pub type Wasm_File = struct {
    allocator: Allocator
    fd: wasm.Fd
}

mut wasm_std_files: [3]Wasm_File

fn _init_std_stream(file: *File, fd: wasm.Fd) {
    wasm_std_files[fd] = {
        .allocator = nil_allocator(),
        .fd = fd,
    }

    file.* = &wasm_std_files[fd]
}

@init
fn _init_std_streams() {
    _init_std_stream(&stdin,  0)
    _init_std_stream(&stdout, 1)
    _init_std_stream(&stderr, 2)
}

@always_inline
fn _new_file(fd: wasm.Fd) -> (*Wasm_File, File_Error) {
    const allocator := heap_allocator()
    const file: *Wasm_File = try allocator.alloc(size_of(Wasm_File))

    file.* = {
        .allocator = heap_allocator(),
        .fd = fd,
    }

    return_ok file
}

@always_inline
fn _map_errno_to_io_error(errno: i64) -> IO_Error {
    return match errno {
        wasm.EINVAL: .Invalid_Argument,
        wasm.ENOENT: .Not_Exist,
        wasm.EACCES: .Permission_Denied,
        wasm.EPERM:  .Permission_Denied,
        wasm.EAGAIN: .Would_Block,
        wasm.EBADF:  .Closed,
        wasm.EINTR:  .Interrupted,

        _: .Unknown
    }
}

fn _open(name: []u8, flags: File_Flags) -> (*Wasm_File, File_Error) {
    if len(name) == 0 {
        return_err .Invalid_Path
    }

    mut o_flags: i32 = 0
    if .Write in flags {
        o_flags = wasm.O_RDWR when .Read in flags else wasm.O_WRONLY
    } else {
        o_flags = wasm.O_RDONLY
    }

    if .Create       in flags { o_flags |= wasm.O_CREAT    }
    if .Truncate     in flags { o_flags |= wasm.O_TRUNC    }
    if .Append       in flags { o_flags |= wasm.O_APPEND   }
    if .Sync         in flags { o_flags |= wasm.O_DSYNC    }
    if .Non_Blocking in flags { o_flags |= wasm.O_NONBLOCK }
    if .Exclusive    in flags { o_flags |= wasm.O_EXCL     }

    const result := wasm.open(name, o_flags, 0o666)
    if result < 0 {
        return_err _map_errno_to_io_error(-result)
    }

    const fd := cast(result, wasm.Fd)
    const file, err := _new_file(fd)
    defer if err {
        wasm.close(fd)
    }

    if err {
        return_err err
    }

    return_ok file
}

impl File for Wasm_File {
    fn read(self, dst: []u8) -> (usize, ?IO_Error) {
        const result := wasm.read(self.fd, dst, len(dst))
        if result < 0 {
            return_err _map_errno_to_io_error(-result)
        }

        if result == 0 {
            return_err .Eof
        }

        return_ok cast(result, usize)
    }

    fn write(self, src: []byte) -> (usize, ?IO_Error) {
        const result := wasm.write(self.fd, src, len(src))
        if result < 0 {
            return_err _map_errno_to_io_error(-result)
        }

        return_ok cast(result, usize)
    }

    fn seek(self, offset: i64, whence: Seek_From) -> (i64, ?IO_Error) {
        const result := wasm.lseek(self.fd, offset, cast(whence, i32))
        if result < 0 {
            return_err _map_errno_to_io_error(-result)
        }

        return_ok result
    }

    fn current(self) -> (i64, ?IO_Error) {
        return self.seek(0, .Current)
    }

    fn size(self) -> (usize, ?IO_Error) {
        const curr := try self.seek(0, .Current)
        const end := try self.seek(0, .End)

        try self.seek(cast(curr, i64), .Start)

        return_ok cast(end, usize)
    }

    fn close(self) -> ?IO_Error {
        const result := wasm.close(self.fd)
        if result < 0 {
            return_err _map_errno_to_io_error(-result)
        }

        return_ok
    }

    fn destroy(self) {
        if self.fd == -1 {
            return
        }

        wasm.close(self.fd)

        self.fd = -1
        self.allocator.free(self)
    }
}
