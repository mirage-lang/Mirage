macro align_up(value: usize, alignment: usize) -> (value + alignment - 1) & ~(alignment - 1)

// Copies n bytes from src to dest
pub fn copy(dst: anyptr, src: anyptr, n: usize) -> anyptr {
    if dst == src || n == 0 {
        return dst
    }

    const d: *u8 = dst
    const s: *u8 = src

    for i in ..n {
        d[i] = s[i]
    }

    return dst
}

// Moves n bytes from src to dest
pub fn move(dst: anyptr, src: anyptr, n: usize) -> anyptr {
    if dst == src || n == 0 {
        return dst
    }

    const d: *u8 = dst
    const s: *u8 = src

    if d < s {
        for i in ..n {
            d[i] = s[i]
        }
    } else {
        for i in ..n {
            const j := n - i - 1
            
            d[j] = s[j]
        }
    }

    return dst
}

// Compares whether the first n bytes of a and b
pub fn compare(a: anyptr, b: anyptr, mut n: usize) -> i32 {
    mut p1 := cast(a, *u8)
    mut p2 := cast(b, *u8)

    while n-- > 0 {
        if p1.* != p2.* {
            return cast(p1.*, i32) - cast(p2.*, i32)
        }

        p1++
        p2++
    }

    return 0
}
