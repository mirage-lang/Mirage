*
**********************************************************************************************/
import("core/math")

//------------------------------------------------------------------------------
// Defines and Macros
//------------------------------------------------------------------------------
pub const EPSILON: f32 = 0.000001

//------------------------------------------------------------------------------
// Module Functions Definition - Utils math
//------------------------------------------------------------------------------

// Clamp float value
pub fn Clamp(value: f32, min: f32, max: f32) -> f32 {
    mut result := value < min ? min : value

    if result > max { result = max }

    return result
}

// Calculate linear interpolation between two floats
pub fn Lerp(start: f32, end: f32, amount: f32) -> f32 {
    const result := start + amount * (end - start)

    return result
}

// Normalize input value within input range
pub fn Normalize(value: f32, start: f32, end: f32) -> f32 {
    const result := (value - start) / (end - start)

    return result
}

// Remap input value within input range to output range
pub fn Remap(value: f32, inputStart: f32, inputEnd: f32, outputStart: f32, outputEnd: f32) -> f32 {
    const result := (value - inputStart) / (inputEnd - inputStart) * (outputEnd - outputStart) + outputStart

    return result
}

// Wrap input value from min to max
// pub fn Wrap(value: f32, min: f32, max: f32) -> f32 {
//     const result := value - (max - min) * floorf((value - min) / (max - min))

//     return result
// }

// Check whether two given floats are almost equal
pub fn FloatEquals(x: f32, y: f32) -> bool {
    const result := (abs(x - y)) <= (EPSILON * max[f32](1.0, max(abs(x), abs(y))))

    return result
}

//------------------------------------------------------------------------------
// Module Functions Definition - Vector2 math
//------------------------------------------------------------------------------

// Vector with components value 0.0f
pub fn Vector2Zero() -> Vector2 {
    return {0.0, 0.0}
}

// Vector with components value 1.0f
pub fn Vector2One() -> Vector2 {
    return {1.0, 1.0}
}

// Add two vectors (v1 + v2)
pub fn Vector2Add(v1: Vector2, v2: Vector2) -> Vector2 {
    return {v1.x + v2.x, v1.y + v2.y}
}

// Add vector and float value
pub fn Vector2AddValue(v: Vector2, add: f32) -> Vector2 {
    return {v.x + add, v.y + add}
}

// Check whether two given vectors are almost equal
pub fn Vector2Equals(p: Vector2,  q: Vector2) -> bool {
    return ((abs(p.x - q.x)) <= (EPSILON * max[f32](1.0, max(abs(p.x), abs(q.x))))) &&
           ((abs(p.y - q.y)) <= (EPSILON * max[f32](1.0, max(abs(p.y), abs(q.y)))));
}
