#import("build/options") as options
const target_os := options.target_os
const target_arch := options.target_arch
const shared_lib  := $option("vendor/raylib/shared_lib", false)

// Windows
when target_os == .Windows {
    #link(flag, "/NODEFAULTLIB:msvcrt" when shared_lib else "/NODEFAULTLIB:libcmt")
    
    #link(lib, "libs/windows/raylibdll.lib" when shared_lib else "libs/windows/raylib.lib")

    #link(system, "Winmm.lib")
    #link(system, "Gdi32.lib")
    #link(system, "User32.lib")
    #link(system, "Shell32.lib")
}

// Linux
when target_os == .Linux {
    #link(system, "m")
    #link(system, "X11")

    when target_arch == .X86_64 {
        #link(lib, "libs/linux/libraylib.so.600" when shared_lib else "libs/linux/libraylib.a")
    } else {
        #link(system, "raylib")
    }
}

// WebAssembly
when target_arch == .Wasm32 || target_arch == .Wasm64p32 {
    #link(lib, "libs/wasm/libraylib.web.a")

    // raylib's web backend is built on emscripten's GLFW3 port; without this the link
    // fails on every glfw* symbol rcore.o refers to.
    #link(flag, "-sUSE_GLFW=3")

    // This build of raylib references 'emscripten_sleep' (rcore.o — WaitTime, reached
    // from EndDrawing whenever SetTargetFPS is in effect), which only exists under
    // ASYNCIFY. It is also what makes an ordinary 'while !WindowShouldClose()' loop
    // work in a page: the sleep is where the frame yields back to the browser, so a
    // program written against the desktop shape of raylib needs no restructuring.
    #link(flag, "-sASYNCIFY")
}

// Windows has 32-bit long even on x64...
when target_os == .Windows {
    pub type long = i32
} else {
    pub type long = i64
}
