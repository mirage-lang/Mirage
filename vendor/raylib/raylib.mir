pub ext fn DrawSplineSegmentCatmullRom(p1: Vector2, p2: Vector2, p3: Vector2, p4: Vector2, thick: f32, color: Color) // Draw spline segment: Catmull-Rom, 4 points
pub ext fn DrawSplineSegmentBezierQuadratic(p1: Vector2, c2: Vector2, p3: Vector2, thick: f32, color: Color) // Draw spline segment: Quadratic Bezier, 2 points, 1 control point
pub ext fn DrawSplineSegmentBezierCubic(p1: Vector2, c2: Vector2, c3: Vector2, p4: Vector2, thick: f32, color: Color) // Draw spline segment: Cubic Bezier, 2 points, 2 control points

