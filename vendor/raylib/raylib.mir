pub ext fn GetShapesTexture() -> Texture2D // Get texture that is used for shapes drawing
pub ext fn GetShapesTextureRectangle() -> Rectangle // Get texture source rectangle that is used for shapes drawing

// Basic shapes drawing functions
pub ext fn DrawPixel(posX: i32, posY: i32, color: Color) // Draw a pixel using geometry [Can be slow, use with care]
pub ext fn DrawPixelV(position: Vector2, color: Color) // Draw a pixel using geometry (Vector version) [Can be slow, use with care]
pub ext fn DrawLine(startPosX: i32, startPosY: i32, endPosX: i32, endPosY: i32, color: Color) // Draw a line
pub ext fn DrawLineV(startPos: Vector2, endPos: Vector2, color: Color) // Draw a line (using gl lines)
pub ext fn DrawLineEx(startPos: Vector2, endPos: Vector2, thick: f32, color: Color) // Draw a line (using triangles/quads)
pub ext fn DrawLineStrip(points: *Vector2, pointCount: i32, color: Color) // Draw lines sequence (using gl lines)
pub ext fn DrawLineBezier(startPos: Vector2, endPos: Vector2, thick: f32, color: Color) // Draw line segment cubic-bezier in-out interpolation
pub ext fn DrawLineDashed(startPos: Vector2, endPos: Vector2, dashSize: i32, spaceSize: i32, color: Color) // Draw a dashed line
pub ext fn DrawTriangle(v1: Vector2, v2: Vector2, v3: Vector2, color: Color) // Draw a color-filled triangle, counter-clockwise vertex order
pub ext fn DrawTriangleGradient(v1: Vector2, v2: Vector2, v3: Vector2, c1: Color, c2: Color, c3: Color) // Draw triangle with interpolated colors, counter-clockwise vertex/color order
pub ext fn DrawTriangleLines(v1: Vector2, v2: Vector2, v3: Vector2, color: Color) // Draw triangle outline, counter-clockwise vertex order
pub ext fn DrawTriangleFan(points: *Vector2, pointCount: i32, color: Color) // Draw a triangle fan defined by points (first vertex is the center)
pub ext fn DrawTriangleStrip(points: *Vector2, pointCount: i32, color: Color) // Draw a triangle strip defined by points
pub ext fn DrawRectangle(posX: i32, posY: i32, width: i32, height: i32, color: Color) // Draw a color-filled rectangle
pub ext fn DrawRectangleV(position: Vector2, size: Vector2, color: Color) // Draw a color-filled rectangle (Vector version)
pub ext fn DrawRectangleRec(rec: Rectangle, color: Color) // Draw a color-filled rectangle
pub ext fn DrawRectanglePro(rec: Rectangle, origin: Vector2, rotation: f32, color: Color) // Draw a color-filled rectangle with pro parameters
pub ext fn DrawRectangleGradientV(posX: i32, posY: i32, width: i32, height: i32, top: Color, bottom: Color) // Draw a vertical-gradient-filled rectangle
pub ext fn DrawRectangleGradientH(posX: i32, posY: i32, width: i32, height: i32, left: Color, right: Color) // Draw a horizontal-gradient-filled rectangle
pub ext fn DrawRectangleGradientEx(rec: Rectangle, col1: Color, col2: Color, col3: Color, col4: Color) // Draw a gradient-filled rectangle with custom vertex colors, counter-clockwise color order
pub ext fn DrawRectangleLines(posX: i32, posY: i32, width: i32, height: i32, color: Color) // Draw rectangle outline
pub ext fn DrawRectangleLinesEx(rec: Rectangle, thick: f32, color: Color) // Draw rectangle outline with line thickness
pub ext fn DrawRectangleRounded(rec: Rectangle, roundness: f32, segments: i32, color: Color) // Draw rectangle with rounded edges
pub ext fn DrawRectangleRoundedLines(rec: Rectangle, roundness: f32, segments: i32, color: Color) // Draw rectangle lines with rounded edges
pub ext fn DrawRectangleRoundedLinesEx(rec: Rectangle, roundness: f32, segments: i32, thick: f32, color: Color) // Draw rectangle lines with rounded edges outline and line thickness
pub ext fn DrawPoly(center: Vector2, sides: i32, radius: f32, rotation: f32, color: Color) // Draw a polygon of n sides
pub ext fn DrawPolyLines(center: Vector2, sides: i32, radius: f32, rotation: f32, color: Color) // Draw a polygon outline of n sides
pub ext fn DrawPolyLinesEx(center: Vector2, sides: i32, radius: f32, rotation: f32, thick: f32, color: Color) // Draw a polygon outline of n sides with line thickness
pub ext fn DrawCircle(centerX: i32, centerY: i32, radius: f32, color: Color) // Draw a color-filled circle
pub ext fn DrawCircleV(center: Vector2, radius: f32, color: Color) // Draw a color-filled circle (Vector version)
pub ext fn DrawCircleGradient(center: Vector2, radius: f32, inner: Color, outer: Color) // Draw a gradient-filled circle
pub ext fn DrawCircleSector(center: Vector2, radius: f32, startAngle: f32, endAngle: f32, segments: i32, color: Color) // Draw a piece of a circle
pub ext fn DrawCircleSectorLines(center: Vector2, radius: f32, startAngle: f32, endAngle: f32, segments: i32, color: Color) // Draw circle sector outline
pub ext fn DrawCircleLines(centerX: i32, centerY: i32, radius: f32, color: Color) // Draw circle outline
pub ext fn DrawCircleLinesV(center: Vector2, radius: f32, color: Color) // Draw circle outline (Vector version)
pub ext fn DrawCircleLinesEx(center: Vector2, radius: f32, thick: f32, color: Color) // Draw circle outline with line thickness
pub ext fn DrawEllipse(centerX: i32, centerY: i32, radiusH: f32, radiusV: f32, color: Color) // Draw ellipse
pub ext fn DrawEllipseV(center: Vector2, radiusH: f32, radiusV: f32, color: Color) // Draw ellipse (Vector version)
pub ext fn DrawEllipseLines(centerX: i32, centerY: i32, radiusH: f32, radiusV: f32, color: Color) // Draw ellipse outline
pub ext fn DrawEllipseLinesV(center: Vector2, radiusH: f32, radiusV: f32, color: Color) // Draw ellipse outline (Vector version)
pub ext fn DrawRing(center: Vector2, innerRadius: f32, outerRadius: f32, startAngle: f32, endAngle: f32, segments: i32, color: Color) // Draw ring
pub ext fn DrawRingLines(center: Vector2, innerRadius: f32, outerRadius: f32, startAngle: f32, endAngle: f32, segments: i32, color: Color) // Draw ring outline

