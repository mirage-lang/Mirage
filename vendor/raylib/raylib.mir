pub ext fn DrawTriangle3D(v1: Vector3, v2: Vector3, v3: Vector3, color: Color) // Draw a color-filled triangle, counter-clockwise vertex order
pub ext fn DrawTriangleStrip3D(points: *Vector3, pointCount: i32, color: Color) // Draw a triangle strip defined by points
pub ext fn DrawCube(position: Vector3, width: f32, height: f32, length: f32, color: Color) // Draw cube
pub ext fn DrawCubeV(position: Vector3, size: Vector3, color: Color) // Draw cube (Vector version)
pub ext fn DrawCubeWires(position: Vector3, width: f32, height: f32, length: f32, color: Color) // Draw cube wires
pub ext fn DrawCubeWiresV(position: Vector3, size: Vector3, color: Color) // Draw cube wires (Vector version)
pub ext fn DrawSphere(centerPos: Vector3, radius: f32, color: Color) // Draw sphere
pub ext fn DrawSphereEx(centerPos: Vector3, radius: f32, rings: i32, slices: i32, color: Color) // Draw sphere with defined rings and slices
pub ext fn DrawSphereWires(centerPos: Vector3, radius: f32, rings: i32, slices: i32, color: Color) // Draw sphere wires
pub ext fn DrawCylinder(position: Vector3, radiusTop: f32, radiusBottom: f32, height: f32, sides: i32, color: Color) // Draw a cylinder/cone
pub ext fn DrawCylinderEx(startPos: Vector3, endPos: Vector3, startRadius: f32, endRadius: f32, sides: i32, color: Color) // Draw a cylinder with base at startPos and top at endPos
pub ext fn DrawCylinderWires(position: Vector3, radiusTop: f32, radiusBottom: f32, height: f32, sides: i32, color: Color) // Draw a cylinder/cone wires
pub ext fn DrawCylinderWiresEx(startPos: Vector3, endPos: Vector3, startRadius: f32, endRadius: f32, sides: i32, color: Color) // Draw a cylinder wires with base at startPos and top at endPos
pub ext fn DrawCapsule(startPos: Vector3, endPos: Vector3, radius: f32, rings: i32, slices: i32, color: Color) // Draw a capsule with the center of its sphere caps at startPos and endPos
pub ext fn DrawCapsuleWires(startPos: Vector3, endPos: Vector3, radius: f32, rings: i32, slices: i32, color: Color) // Draw capsule wireframe with the center of its sphere caps at startPos and endPos
pub ext fn DrawPlane(centerPos: Vector3, size: Vector2, color: Color) // Draw a plane XZ
pub ext fn DrawRay(ray: Ray, color: Color) // Draw a ray line
pub ext fn DrawGrid(slices: i32, spacing: f32) // Draw a grid (centered at (0, 0, 0))

//------------------------------------------------------------------------------
// Model 3d Loading and Drawing Functions (Module: models)
//------------------------------------------------------------------------------

// Model management functions
pub ext fn LoadModel(fileName: *u8) -> Model // Load model from files (meshes and materials)
pub ext fn LoadModelFromMesh(mesh: Mesh) -> Model // Load model from generated mesh (default material)
pub ext fn IsModelValid(model: Model) -> bool // Check if model is valid (loaded in GPU, VAO/VBOs)
pub ext fn UnloadModel(model: Model) // Unload model (including meshes) from memory (RAM and/or VRAM)
pub ext fn GetModelBoundingBox(model: Model) -> BoundingBox // Compute model bounding box limits (considers all meshes)

// Model drawing functions
pub ext fn DrawModel(model: Model, position: Vector3, scale: f32, tint: Color) // Draw a model (with texture if set)
pub ext fn DrawModelEx(model: Model, position: Vector3, rotationAxis: Vector3, rotationAngle: f32, scale: Vector3, tint: Color) // Draw a model with custom transform
pub ext fn DrawModelWires(model: Model, position: Vector3, scale: f32, tint: Color) // Draw a model wires (with texture if set)
pub ext fn DrawModelWiresEx(model: Model, position: Vector3, rotationAxis: Vector3, rotationAngle: f32, scale: Vector3, tint: Color) // Draw a model wires with custom transform
pub ext fn DrawBoundingBox(box: BoundingBox, color: Color) // Draw bounding box (wires)
pub ext fn DrawBillboard(camera: Camera, texture: Texture2D, position: Vector3, scale: f32, tint: Color) // Draw a billboard texture
pub ext fn DrawBillboardRec(camera: Camera, texture: Texture2D, rec: Rectangle, position: Vector3, size: Vector2, tint: Color) // Draw a billboard texture defined by rectangle
pub ext fn DrawBillboardPro(camera: Camera, texture: Texture2D, rec: Rectangle, position: Vector3, up: Vector3, size: Vector2, origin: Vector2, rotation: f32, tint: Color) // Draw a billboard texture defined by source rectangle with scaling and rotation

// Mesh management functions
pub ext fn UploadMesh(mesh: *Mesh, dynamic: bool) // Upload mesh vertex data in GPU and provide VAO/VBO ids
pub ext fn UpdateMeshBuffer(mesh: Mesh, index: i32, data: anyptr, dataSize: i32, offset: i32) // Update mesh vertex data in GPU for a specific buffer index
pub ext fn UnloadMesh(mesh: Mesh) // Unload mesh data from CPU and GPU
pub ext fn DrawMesh(mesh: Mesh, material: Material, transform: Matrix) // Draw a 3d mesh with material and transform
pub ext fn DrawMeshInstanced(mesh: Mesh, material: Material, transforms: *Matrix, instances: i32) // Draw multiple mesh instances with material and different transforms
pub ext fn GetMeshBoundingBox(mesh: Mesh) -> BoundingBox // Compute mesh bounding box limits
pub ext fn GenMeshTangents(mesh: *Mesh) // Compute mesh tangents
pub ext fn ExportMesh(mesh: Mesh, fileName: *u8) -> bool // Export mesh data to file, returns true on success
pub ext fn ExportMeshAsCode(mesh: Mesh, fileName: *u8) -> bool // Export mesh as code file (.h) defining multiple arrays of vertex attributes

// Mesh generation functions
pub ext fn GenMeshPoly(sides: i32, radius: f32) -> Mesh // Generate polygonal mesh
pub ext fn GenMeshPlane(width: f32, height: f32, resX: i32, resY: i32) -> Mesh // Generate plane mesh (with subdivisions)
pub ext fn GenMeshCube(width: f32, height: f32, length: f32) -> Mesh // Generate cuboid mesh
pub ext fn GenMeshSphere(radius: f32, rings: i32, slices: i32) -> Mesh // Generate sphere mesh (standard sphere)
pub ext fn GenMeshHemiSphere(radius: f32, rings: i32, slices: i32) -> Mesh // Generate half-sphere mesh (no bottom cap)
pub ext fn GenMeshCylinder(radius: f32, height: f32, slices: i32) -> Mesh // Generate cylinder mesh
pub ext fn GenMeshCone(radius: f32, height: f32, slices: i32) -> Mesh // Generate cone/pyramid mesh
pub ext fn GenMeshTorus(radius: f32, size: f32, radSeg: i32, sides: i32) -> Mesh // Generate torus mesh
pub ext fn GenMeshKnot(radius: f32, size: f32, radSeg: i32, sides: i32) -> Mesh // Generate trefoil knot mesh
pub ext fn GenMeshHeightmap(heightmap: Image, size: Vector3) -> Mesh // Generate heightmap mesh from image data
pub ext fn GenMeshCubicmap(cubicmap: Image, cubeSize: Vector3) -> Mesh // Generate cubes-based map mesh from image data

// Material loading/unloading functions
pub ext fn LoadMaterials(fileName: *u8, materialCount: *i32) -> *Material // Load materials from model file
pub ext fn LoadMaterialDefault() -> Material // Load default material (Supports: DIFFUSE, SPECULAR, NORMAL maps)
pub ext fn IsMaterialValid(material: Material) -> bool // Check if material is valid (shader assigned, map textures loaded in GPU)
pub ext fn UnloadMaterial(material: Material) // Unload material from GPU memory (VRAM)
pub ext fn SetMaterialTexture(material: *Material, mapType: MaterialMapIndex, texture: Texture2D) // Set texture for a material map type (MATERIAL_MAP_DIFFUSE, MATERIAL_MAP_SPECULAR...)
pub ext fn SetModelMeshMaterial(model: *Model, meshId: i32, materialId: i32) // Set material for a mesh

// Model animations loading/unloading functions
pub ext fn LoadModelAnimations(fileName: *u8, animCount: *i32) -> *ModelAnimation // Load model animations from file
pub ext fn UpdateModelAnimation(model: Model, anim: ModelAnimation, frame: f32) // Update model animation pose (vertex buffers and bone matrices)
pub ext fn UpdateModelAnimationEx(model: Model, animA: ModelAnimation, frameA: f32, animB: ModelAnimation, frameB: f32, blend: f32) // Update model animation pose, blending two animations
pub ext fn UnloadModelAnimations(animations: *ModelAnimation, animCount: i32) // Unload animation array data
pub ext fn IsModelAnimationValid(model: Model, anim: ModelAnimation) -> bool // Check model animation skeleton match

// Collision detection functions
pub ext fn CheckCollisionSpheres(center1: Vector3, radius1: f32, center2: Vector3, radius2: f32) -> bool // Check collision between two spheres
pub ext fn CheckCollisionBoxes(box1: BoundingBox, box2: BoundingBox) -> bool // Check collision between two bounding boxes
pub ext fn CheckCollisionBoxSphere(box: BoundingBox, center: Vector3, radius: f32) -> bool // Check collision between box and sphere
pub ext fn GetRayCollisionSphere(ray: Ray, center: Vector3, radius: f32) -> RayCollision // Get collision info between ray and sphere
pub ext fn GetRayCollisionBox(ray: Ray, box: BoundingBox) -> RayCollision // Get collision info between ray and box
pub ext fn GetRayCollisionMesh(ray: Ray, mesh: Mesh, transform: Matrix) -> RayCollision // Get collision info between ray and mesh
pub ext fn GetRayCollisionTriangle(ray: Ray, p1: Vector3, p2: Vector3, p3: Vector3) -> RayCollision // Get collision info between ray and triangle
pub ext fn GetRayCollisionQuad(ray: Ray, p1: Vector3, p2: Vector3, p3: Vector3, p4: Vector3) -> RayCollision // Get collision info between ray and quad

//------------------------------------------------------------------------------
// Audio Loading and Playing Functions (Module: audio)
//------------------------------------------------------------------------------
pub type AudioCallback = fn(bufferData: anyptr, frames: u32)

// Audio device management functions
pub ext fn InitAudioDevice() // Initialize audio device and context
pub ext fn CloseAudioDevice() // Close the audio device and context
pub ext fn IsAudioDeviceReady() -> bool // Check if audio device has been initialized successfully
pub ext fn SetMasterVolume(volume: f32) // Set master volume (listener)
pub ext fn GetMasterVolume() -> f32 // Get master volume (listener)

// Wave/Sound loading/unloading functions
pub ext fn LoadWave(fileName: *u8) -> Wave // Load wave data from file
pub ext fn LoadWaveFromMemory(fileType: *u8, fileData: *u8, dataSize: i32) -> Wave // Load wave from memory buffer, fileType refers to extension: i.e. '.wav'
pub ext fn IsWaveValid(wave: Wave) -> bool // Check if wave data is valid (data loaded and parameters)
pub ext fn LoadSound(fileName: *u8) -> Sound // Load sound from file
pub ext fn LoadSoundFromWave(wave: Wave) -> Sound // Load sound from wave data
pub ext fn LoadSoundAlias(source: Sound) -> Sound // Load sound alias, new sound that shares the same sample data as the source sound, does not own the sound data
pub ext fn IsSoundValid(sound: Sound) -> bool // Check if sound is valid (data loaded and buffers initialized)
pub ext fn UpdateSound(sound: Sound, data: anyptr, frameCount: i32) // Update sound buffer with new data (default data format: 32 bit float, stereo)
pub ext fn UnloadWave(wave: Wave) // Unload wave data
pub ext fn UnloadSound(sound: Sound) // Unload sound
pub ext fn UnloadSoundAlias(alias: Sound) // Unload sound alias (does not deallocate sample data)
pub ext fn ExportWave(wave: Wave, fileName: *u8) -> bool // Export wave data to file, returns true on success
pub ext fn ExportWaveAsCode(wave: Wave, fileName: *u8) -> bool // Export wave sample data to code (.h), returns true on success

// Wave/Sound management functions
pub ext fn PlaySound(sound: Sound) // Play a sound
pub ext fn StopSound(sound: Sound) // Stop playing a sound
pub ext fn PauseSound(sound: Sound) // Pause a sound
pub ext fn ResumeSound(sound: Sound) // Resume a paused sound
pub ext fn IsSoundPlaying(sound: Sound) -> bool // Check if sound is currently playing
pub ext fn SetSoundVolume(sound: Sound, volume: f32) // Set volume for a sound (1.0 is max level)
pub ext fn SetSoundPitch(sound: Sound, pitch: f32) // Set pitch for a sound (1.0 is base level)
pub ext fn SetSoundPan(sound: Sound, pan: f32) // Set pan for a sound (-1.0 left, 0.0 center, 1.0 right)
pub ext fn WaveCopy(wave: Wave) -> Wave // Copy a wave to a new wave
pub ext fn WaveCrop(wave: *Wave, initFrame: i32, finalFrame: i32) // Crop a wave to defined frames range
pub ext fn WaveFormat(wave: *Wave, sampleRate: i32, sampleSize: i32, channels: i32) // Convert wave data to desired format
pub ext fn LoadWaveSamples(wave: Wave) -> *f32 // Load samples data from wave as a 32bit float data array
pub ext fn UnloadWaveSamples(samples: *f32) // Unload samples data loaded with LoadWaveSamples()

// Music management functions
pub ext fn LoadMusicStream(fileName: *u8) -> Music // Load music stream from file
pub ext fn LoadMusicStreamFromMemory(fileType: *u8, data: *u8, dataSize: i32) -> Music // Load music stream from data
pub ext fn IsMusicValid(music: Music) -> bool // Check if music stream is valid (context and buffers initialized)
pub ext fn UnloadMusicStream(music: Music) // Unload music stream
pub ext fn PlayMusicStream(music: Music) // Start music playing
pub ext fn IsMusicStreamPlaying(music: Music) -> bool // Check if music is playing
pub ext fn UpdateMusicStream(music: Music) // Update buffers for music streaming
pub ext fn StopMusicStream(music: Music) // Stop music playing
pub ext fn PauseMusicStream(music: Music) // Pause music playing
pub ext fn ResumeMusicStream(music: Music) // Resume playing paused music
pub ext fn SeekMusicStream(music: Music, position: f32) // Seek music to a position (in seconds)
pub ext fn SetMusicVolume(music: Music, volume: f32) // Set volume for music (1.0 is max level)
pub ext fn SetMusicPitch(music: Music, pitch: f32) // Set pitch for music (1.0 is base level)
pub ext fn SetMusicPan(music: Music, pan: f32) // Set pan for music (-1.0 left, 0.0 center, 1.0 right)
pub ext fn GetMusicTimeLength(music: Music) -> f32 // Get music time length (in seconds)
pub ext fn GetMusicTimePlayed(music: Music) -> f32 // Get current music time played (in seconds)

// AudioStream management functions
pub ext fn LoadAudioStream(sampleRate: u32, sampleSize: u32, channels: u32) -> AudioStream // Load audio stream (to stream raw audio pcm data)
pub ext fn IsAudioStreamValid(stream: AudioStream) -> bool // Check if an audio stream is valid (buffers initialized)
pub ext fn UnloadAudioStream(stream: AudioStream) // Unload audio stream and free memory
pub ext fn UpdateAudioStream(stream: AudioStream, data: anyptr, frameCount: i32) // Update audio stream buffers with data
pub ext fn IsAudioStreamProcessed(stream: AudioStream) -> bool // Check if any audio stream buffers requires refill
pub ext fn PlayAudioStream(stream: AudioStream) // Play audio stream
pub ext fn PauseAudioStream(stream: AudioStream) // Pause audio stream
pub ext fn ResumeAudioStream(stream: AudioStream) // Resume audio stream
pub ext fn IsAudioStreamPlaying(stream: AudioStream) -> bool // Check if audio stream is playing
pub ext fn StopAudioStream(stream: AudioStream) // Stop audio stream
pub ext fn SetAudioStreamVolume(stream: AudioStream, volume: f32) // Set volume for audio stream (1.0 is max level)
pub ext fn SetAudioStreamPitch(stream: AudioStream, pitch: f32) // Set pitch for audio stream (1.0 is base level)
pub ext fn SetAudioStreamPan(stream: AudioStream, pan: f32) // Set pan for audio stream (-1.0 left, 0.0 center, 1.0 right)
pub ext fn SetAudioStreamBufferSizeDefault(size: i32) // Default size for new audio streams
pub ext fn SetAudioStreamCallback(stream: AudioStream, callback: AudioCallback) // Audio thread callback to request new data

pub ext fn AttachAudioStreamProcessor(stream: AudioStream, processor: AudioCallback) // Attach audio stream processor to stream, receives frames x 2 samples as 'float' (stereo)
pub ext fn DetachAudioStreamProcessor(stream: AudioStream, processor: AudioCallback) // Detach audio stream processor from stream

pub ext fn AttachAudioMixedProcessor(processor: AudioCallback) // Attach audio stream processor to the entire audio pipeline, receives frames x 2 samples as 'float' (stereo)
pub ext fn DetachAudioMixedProcessor(processor: AudioCallback) // Detach audio stream processor from the entire audio pipeline
