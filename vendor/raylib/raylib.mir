pub ext fn GetSplinePointBasis(p1: Vector2, p2: Vector2, p3: Vector2, p4: Vector2, t: f32) -> Vector2 // Get (evaluate) spline point: B-Spline
pub ext fn GetSplinePointCatmullRom(p1: Vector2, p2: Vector2, p3: Vector2, p4: Vector2, t: f32) -> Vector2 // Get (evaluate) spline point: Catmull-Rom
pub ext fn GetSplinePointBezierQuadratic(p1: Vector2, c2: Vector2, p3: Vector2, t: f32) -> Vector2 // Get (evaluate) spline point: Quadratic Bezier
pub ext fn GetSplinePointBezierCubic(p1: Vector2, c2: Vector2, c3: Vector2, p4: Vector2, t: f32) -> Vector2 // Get (evaluate) spline point: Cubic Bezier

// Basic shapes collision detection functions
pub ext fn CheckCollisionRecs(rec1: Rectangle, rec2: Rectangle) -> bool // Check collision between two rectangles
pub ext fn CheckCollisionCircles(center1: Vector2, radius1: f32, center2: Vector2, radius2: f32) -> bool // Check collision between two circles
pub ext fn CheckCollisionCircleRec(center: Vector2, radius: f32, rec: Rectangle) -> bool // Check collision between circle and rectangle
pub ext fn CheckCollisionCircleLine(center: Vector2, radius: f32, p1: Vector2, p2: Vector2) -> bool // Check if circle collides with a line created between two points [p1] and [p2]
pub ext fn CheckCollisionPointRec(point: Vector2, rec: Rectangle) -> bool // Check if point is inside rectangle
pub ext fn CheckCollisionPointCircle(point: Vector2, center: Vector2, radius: f32) -> bool // Check if point is inside circle
pub ext fn CheckCollisionPointTriangle(point: Vector2, p1: Vector2, p2: Vector2, p3: Vector2) -> bool // Check if point is inside a triangle
pub ext fn CheckCollisionPointLine(point: Vector2, p1: Vector2, p2: Vector2, threshold: i32) -> bool // Check if point belongs to line created between two points [p1] and [p2] with defined margin in pixels [threshold]
pub ext fn CheckCollisionPointPoly(point: Vector2, points: *Vector2, pointCount: i32) -> bool // Check if point is within a polygon described by array of vertices
pub ext fn CheckCollisionLines(startPos1: Vector2, endPos1: Vector2, startPos2: Vector2, endPos2: Vector2, collisionPoint: *Vector2) -> bool // Check the collision between two lines defined by two points each, returns collision point by reference
pub ext fn GetCollisionRec(rec1: Rectangle, rec2: Rectangle) -> Rectangle // Get collision rectangle for two rectangles collision

//------------------------------------------------------------------------------
// Texture Loading and Drawing Functions (Module: textures)
//------------------------------------------------------------------------------

// Image loading functions
// NOTE: These functions do not require GPU access
pub ext fn LoadImage(fileName: *u8) -> Image // Load image from file into CPU memory (RAM)
pub ext fn LoadImageRaw(fileName: *u8, width: i32, height: i32, format: i32, headerSize: i32) -> Image // Load image from RAW file data
pub ext fn LoadImageAnim(fileName: *u8, frames: *i32) -> Image // Load image sequence from file (frames appended to image.data)
pub ext fn LoadImageAnimFromMemory(fileType: *u8, fileData: *u8, dataSize: i32, frames: *i32) -> Image // Load image sequence from memory buffer
pub ext fn LoadImageFromMemory(fileType: *u8, fileData: *u8, dataSize: i32) -> Image // Load image from memory buffer, fileType refers to extension: i.e. '.png'
pub ext fn LoadImageFromTexture(texture: Texture2D) -> Image // Load image from GPU texture data
pub ext fn LoadImageFromScreen() -> Image // Load image from screen buffer (screenshot)
pub ext fn IsImageValid(image: Image) -> bool // Check if an image is valid (data and parameters)
pub ext fn UnloadImage(image: Image) // Unload image from CPU memory (RAM)
pub ext fn ExportImage(image: Image, fileName: *u8) -> bool // Export image data to file, returns true on success
pub ext fn ExportImageToMemory(image: Image, fileType: *u8, fileSize: *i32) -> *u8 // Export image to memory buffer, memory must be MemFree()
pub ext fn ExportImageAsCode(image: Image, fileName: *u8) -> bool // Export image as code file defining an array of bytes, returns true on success

// Image generation functions
pub ext fn GenImageColor(width: i32, height: i32, color: Color) -> Image // Generate image: plain color
pub ext fn GenImageGradientLinear(width: i32, height: i32, direction: i32, start: Color, end: Color) -> Image // Generate image: linear gradient, direction in degrees [0..360], 0=Vertical gradient
pub ext fn GenImageGradientRadial(width: i32, height: i32, density: f32, inner: Color, outer: Color) -> Image // Generate image: radial gradient
pub ext fn GenImageGradientSquare(width: i32, height: i32, density: f32, inner: Color, outer: Color) -> Image // Generate image: square gradient
pub ext fn GenImageChecked(width: i32, height: i32, checksX: i32, checksY: i32, col1: Color, col2: Color) -> Image // Generate image: checked
pub ext fn GenImageWhiteNoise(width: i32, height: i32, factor: f32) -> Image // Generate image: white noise
pub ext fn GenImagePerlinNoise(width: i32, height: i32, offsetX: i32, offsetY: i32, scale: f32) -> Image // Generate image: perlin noise
pub ext fn GenImageCellular(width: i32, height: i32, tileSize: i32) -> Image // Generate image: cellular algorithm, bigger tileSize means bigger cells
pub ext fn GenImageText(width: i32, height: i32, text: *u8) -> Image // Generate image: grayscale image from text data

// Image manipulation functions
pub ext fn ImageCopy(image: Image) -> Image // Create an image duplicate (useful for transformations)
pub ext fn ImageFromImage(image: Image, rec: Rectangle) -> Image // Create an image from another image piece
pub ext fn ImageFromChannel(image: Image, selectedChannel: i32) -> Image // Create an image from a selected channel of another image (GRAYSCALE)
pub ext fn ImageText(text: *u8, fontSize: i32, color: Color) -> Image // Create an image from text (default font)
pub ext fn ImageTextEx(font: Font, text: *u8, fontSize: f32, spacing: f32, tint: Color) -> Image // Create an image from text (custom sprite font)
pub ext fn ImageFormat(image: *Image, newFormat: i32) // Convert image data to desired format
pub ext fn ImageToPOT(image: *Image, fill: Color) // Convert image to POT (power-of-two)
pub ext fn ImageCrop(image: *Image, crop: Rectangle) // Crop an image to a defined rectangle
pub ext fn ImageAlphaCrop(image: *Image, threshold: f32) // Crop image depending on alpha value
pub ext fn ImageAlphaClear(image: *Image, color: Color, threshold: f32) // Clear alpha channel to desired color
pub ext fn ImageAlphaMask(image: *Image, alphaMask: Image) // Apply alpha mask to image
pub ext fn ImageAlphaPremultiply(image: *Image) // Premultiply alpha channel
pub ext fn ImageBlurGaussian(image: *Image, blurSize: i32) // Apply Gaussian blur using a box blur approximation
pub ext fn ImageKernelConvolution(image: *Image, kernel: *f32, kernelSize: i32) // Apply custom square convolution kernel to image
pub ext fn ImageResize(image: *Image, newWidth: i32, newHeight: i32) // Resize image (Bicubic scaling algorithm)
pub ext fn ImageResizeNN(image: *Image, newWidth: i32, newHeight: i32) // Resize image (Nearest-Neighbor scaling algorithm)
pub ext fn ImageResizeCanvas(image: *Image, newWidth: i32, newHeight: i32, offsetX: i32, offsetY: i32, fill: Color) // Resize canvas and fill with color
pub ext fn ImageMipmaps(image: *Image) // Compute all mipmap levels for a provided image
pub ext fn ImageDither(image: *Image, rBpp: i32, gBpp: i32, bBpp: i32, aBpp: i32) // Dither image data to 16bpp or lower (Floyd-Steinberg dithering)
pub ext fn ImageFlipVertical(image: *Image) // Flip image vertically
pub ext fn ImageFlipHorizontal(image: *Image) // Flip image horizontally
pub ext fn ImageRotate(image: *Image, degrees: i32) // Rotate image by input angle in degrees (-359 to 359)
pub ext fn ImageRotateCW(image: *Image) // Rotate image clockwise 90deg
pub ext fn ImageRotateCCW(image: *Image) // Rotate image counter-clockwise 90deg
pub ext fn ImageColorTint(image: *Image, color: Color) // Modify image color: tint
pub ext fn ImageColorInvert(image: *Image) // Modify image color: invert
pub ext fn ImageColorGrayscale(image: *Image) // Modify image color: grayscale
pub ext fn ImageColorContrast(image: *Image, contrast: i32) // Modify image color: contrast (-100 to 100)
pub ext fn ImageColorBrightness(image: *Image, brightness: i32) // Modify image color: brightness (-255 to 255)
pub ext fn ImageColorReplace(image: *Image, color: Color, replace: Color) // Modify image color: replace color
pub ext fn LoadImageColors(image: Image) -> *Color // Load color data from image as a Color array (RGBA - 32bit)
pub ext fn LoadImagePalette(image: Image, maxPaletteSize: i32, colorCount: *i32) -> *Color // Load colors palette from image as a Color array (RGBA - 32bit)
pub ext fn UnloadImageColors(colors: *Color) // Unload color data loaded with LoadImageColors()
pub ext fn UnloadImagePalette(colors: *Color) // Unload colors palette loaded with LoadImagePalette()
pub ext fn GetImageAlphaBorder(image: Image, threshold: f32) -> Rectangle // Get image alpha border rectangle
pub ext fn GetImageColor(image: Image, x: i32, y: i32) -> Color // Get image pixel color at (x, y) position

// Image drawing functions
// NOTE: Image software-rendering functions (CPU)
pub ext fn ImageClearBackground(dst: *Image, color: Color) // Clear image background with provided color
pub ext fn ImageDrawPixel(dst: *Image, posX: i32, posY: i32, color: Color) // Draw pixel within an image
pub ext fn ImageDrawPixelV(dst: *Image, position: Vector2, color: Color) // Draw pixel within an image (Vector version)
pub ext fn ImageDrawLine(dst: *Image, startPosX: i32, startPosY: i32, endPosX: i32, endPosY: i32, color: Color) // Draw line within an image
pub ext fn ImageDrawLineV(dst: *Image, start: Vector2, end: Vector2, color: Color) // Draw line within an image (Vector version)
pub ext fn ImageDrawLineEx(dst: *Image, start: Vector2, end: Vector2, thick: i32, color: Color) // Draw a line defining thickness within an image
pub ext fn ImageDrawLineStrip(dst: *Image, points: *Vector2, pointCount: i32, color: Color) // Draw a lines sequence within an image
pub ext fn ImageDrawTriangle(dst: *Image, v1: Vector2, v2: Vector2, v3: Vector2, color: Color) // Draw triangle within an image
pub ext fn ImageDrawTriangleGradient(dst: *Image, v1: Vector2, v2: Vector2, v3: Vector2, c1: Color, c2: Color, c3: Color) // Draw triangle with interpolated colors within an image
pub ext fn ImageDrawTriangleLines(dst: *Image, v1: Vector2, v2: Vector2, v3: Vector2, color: Color) // Draw triangle outline within an image
pub ext fn ImageDrawTriangleFan(dst: *Image, points: *Vector2, pointCount: i32, color: Color) // Draw a triangle fan defined by points within an image (first vertex is the center)
pub ext fn ImageDrawTriangleStrip(dst: *Image, points: *Vector2, pointCount: i32, color: Color) // Draw a triangle strip defined by points within an image
pub ext fn ImageDrawRectangle(dst: *Image, posX: i32, posY: i32, width: i32, height: i32, color: Color) // Draw rectangle within an image
pub ext fn ImageDrawRectangleV(dst: *Image, position: Vector2, size: Vector2, color: Color) // Draw rectangle within an image (Vector version)
pub ext fn ImageDrawRectangleRec(dst: *Image, rec: Rectangle, color: Color) // Draw rectangle within an image
pub ext fn ImageDrawRectanglePro(dst: *Image, rec: Rectangle, origin: Vector2, rotation: f32, color: Color) // Draw a color-filled rectangle with pro parameters within and image
pub ext fn ImageDrawRectangleLines(dst: *Image, posX: i32, posY: i32, width: i32, height: i32, color: Color) // Draw rectangle lines within an image
pub ext fn ImageDrawRectangleLinesEx(dst: *Image, rec: Rectangle, thick: i32, color: Color) // Draw rectangle lines within an image with line thickness
pub ext fn ImageDrawRectangleGradientEx(dst: *Image, rec: Rectangle, col1: Color, col2: Color, col3: Color, col4: Color) // Draw rectangle with gradient colors within an image, counter-clockwise color order
pub ext fn ImageDrawCircle(dst: *Image, centerX: i32, centerY: i32, radius: i32, color: Color) // Draw a filled circle within an image
pub ext fn ImageDrawCircleV(dst: *Image, center: Vector2, radius: i32, color: Color) // Draw a filled circle within an image (Vector version)
pub ext fn ImageDrawCircleLines(dst: *Image, centerX: i32, centerY: i32, radius: i32, color: Color) // Draw circle outline within an image
pub ext fn ImageDrawCircleLinesV(dst: *Image, center: Vector2, radius: i32, color: Color) // Draw circle outline within an image (Vector version)
pub ext fn ImageDrawCircleGradient(dst: *Image, center: Vector2, radius: f32, inner: Color, outer: Color) // Draw a gradient-filled circle within an image

pub ext fn ImageDrawImage(dst: *Image, src: Image, posX: i32, posY: i32, tint: Color) // Draw an image within an image
pub ext fn ImageDrawImageEx(dst: *Image, src: Image, position: Vector2, rotation: f32, scale: f32, tint: Color) // Draw an image with scaling and rotation within an image
pub ext fn ImageDrawImageRec(dst: *Image, src: Image, srcRec: Rectangle, position: Vector2, tint: Color) // Draw a part of an image defined by a rectangle within an image
pub ext fn ImageDrawImagePro(dst: *Image, src: Image, srcRec: Rectangle, dstRec: Rectangle, origin: Vector2, rotation: f32, tint: Color) // Draw a part of an image defined by a rectangle into destination rectangle, with scaling and rotation, within an image
pub ext fn ImageDrawText(dst: *Image, text: *u8, posX: i32, posY: i32, fontSize: i32, color: Color) // Draw text (using default font) within an image (destination)
pub ext fn ImageDrawTextEx(dst: *Image, font: Font, text: *u8, position: Vector2, fontSize: f32, spacing: f32, tint: Color) // Draw text (custom sprite font) within an image (destination)
pub ext fn ImageDrawTextPro(dst: *Image, font: Font, text: *u8, position: Vector2, origin: Vector2, rotation: f32, fontSize: f32, spacing: f32, tint: Color) // Draw text using Font and pro parameters (rotation)

// Texture loading functions
// NOTE: These functions require GPU access
pub ext fn LoadTexture(fileName: *u8) -> Texture2D // Load texture from file into GPU memory (VRAM)
pub ext fn LoadTextureFromImage(image: Image) -> Texture2D // Load texture from image data
pub ext fn LoadTextureCubemap(image: Image, layout: CubemapLayout) -> TextureCubemap // Load cubemap from image, multiple image cubemap layouts supported
pub ext fn LoadRenderTexture(width: i32, height: i32) -> RenderTexture2D // Load texture for rendering (framebuffer)
pub ext fn IsTextureValid(texture: Texture2D) -> bool // Check if texture is valid (loaded in GPU)
pub ext fn UnloadTexture(texture: Texture2D) // Unload texture from GPU memory (VRAM)
pub ext fn IsRenderTextureValid(target: RenderTexture2D) -> bool // Check if render texture is valid (loaded in GPU)
pub ext fn UnloadRenderTexture(target: RenderTexture2D) // Unload render texture from GPU memory (VRAM)
pub ext fn UpdateTexture(texture: Texture2D, pixels: anyptr) // Update GPU texture with new data (pixels should be able to fill texture)
pub ext fn UpdateTextureRec(texture: Texture2D, rec: Rectangle, pixels: anyptr) // Update GPU texture rectangle with new data (pixels and rec should fit in texture)

// Texture configuration functions
pub ext fn GenTextureMipmaps(texture: *Texture2D) // Generate GPU mipmaps for a texture
pub ext fn SetTextureFilter(texture: Texture2D, filter: TextureFilter) // Set texture scaling filter mode
pub ext fn SetTextureWrap(texture: Texture2D, wrap: TextureWrap) // Set texture wrapping mode

// Texture drawing functions
pub ext fn DrawTexture(texture: Texture2D, posX: i32, posY: i32, tint: Color) // Draw a Texture2D
pub ext fn DrawTextureV(texture: Texture2D, position: Vector2, tint: Color) // Draw a Texture2D with position defined as Vector2
pub ext fn DrawTextureEx(texture: Texture2D, position: Vector2, rotation: f32, scale: f32, tint: Color) // Draw a Texture2D with rotation and scale
pub ext fn DrawTextureRec(texture: Texture2D, rec: Rectangle, position: Vector2, tint: Color) // Draw a part of a texture defined by a rectangle
pub ext fn DrawTexturePro(texture: Texture2D, srcrec: Rectangle, dstrec: Rectangle, origin: Vector2, rotation: f32, tint: Color) // Draw a part of a texture defined by a source rectangle to destination rectangle, with scaling and rotation
pub ext fn DrawTextureNPatch(texture: Texture2D, nPatchInfo: NPatchInfo, dstrec: Rectangle, origin: Vector2, rotation: f32, tint: Color) // Draw a texture (or part of it) that stretches or shrinks nicely

// Color/pixel related functions
pub ext fn ColorIsEqual(col1: Color, col2: Color) -> bool // Check if two colors are equal
pub ext fn Fade(color: Color, alpha: f32) -> Color // Get color with alpha applied, alpha goes from 0.0f to 1.0f
pub ext fn ColorToInt(color: Color) -> i32 // Get hexadecimal value for a Color (0xRRGGBBAA)
pub ext fn ColorNormalize(color: Color) -> Vector4 // Get Color normalized as float [0..1]
pub ext fn ColorFromNormalized(normalized: Vector4) -> Color // Get Color from normalized values [0..1]
pub ext fn ColorToHSV(color: Color) -> Vector3 // Get HSV values for a Color, hue [0..360], saturation/value [0..1]
pub ext fn ColorFromHSV(hue: f32, saturation: f32, value: f32) -> Color // Get a Color from HSV values, hue [0..360], saturation/value [0..1]
pub ext fn ColorTint(color: Color, tint: Color) -> Color // Get color multiplied with another color
pub ext fn ColorBrightness(color: Color, factor: f32) -> Color // Get color with brightness correction, brightness factor goes from -1.0f to 1.0f
pub ext fn ColorContrast(color: Color, contrast: f32) -> Color // Get color with contrast correction, contrast values between -1.0f and 1.0f
pub ext fn ColorAlpha(color: Color, alpha: f32) -> Color // Get color with alpha applied, alpha goes from 0.0f to 1.0f
pub ext fn ColorAlphaBlend(dst: Color, src: Color, tint: Color) -> Color // Get src alpha-blended into dst color with tint
pub ext fn ColorLerp(color1: Color, color2: Color, factor: f32) -> Color // Get color lerp interpolation between two colors, factor [0.0f..1.0f]
pub ext fn GetColor(hexValue: u32) -> Color // Get Color structure from hexadecimal value
pub ext fn GetPixelColor(srcPtr: anyptr, format: PixelFormat) -> Color // Get Color from a source pixel pointer of certain format
pub ext fn SetPixelColor(dstPtr: anyptr, color: Color, format: PixelFormat) // Set color formatted into destination pixel pointer
pub ext fn GetPixelDataSize(width: i32, height: i32, format: PixelFormat) -> i32 // Get pixel data size in bytes for certain format

//------------------------------------------------------------------------------
// Font Loading and Text Drawing Functions (Module: text)
//------------------------------------------------------------------------------

// Font loading/unloading functions
pub ext fn GetFontDefault() -> Font // Get the default Font
pub ext fn LoadFont(fileName: *u8) -> Font //  Load font from file into GPU memory (VRAM)
pub ext fn LoadFontEx(fileName: *u8, fontSize: i32, codepoints: *i32, codepointCount: i32) -> Font // Load font from file with defined codepoints and generation size, use NULL for codepoints and 0 for codepointCount to load the default character set, font size is provided in pixels height
pub ext fn LoadFontFromImage(image: Image, key: Color, firstChar: i32) -> Font // Load font from Image (XNA style)
pub ext fn LoadFontFromMemory(fileType: *u8, fileData: *u8, dataSize: i32, fontSize: i32, codepoints: *i32, codepointCount: i32) -> Font // Load font from memory buffer, fileType refers to extension: i.e. '.ttf'
pub ext fn IsFontValid(font: Font) -> bool // Check if font is valid (font data loaded, WARNING: GPU texture not checked)
pub ext fn LoadFontData(fileData: *u8, dataSize: i32, fontSize: i32, codepoints: *i32, codepointCount: i32, typ: i32, glyphCount: *i32) -> *GlyphInfo // Load font data for further use
pub ext fn GenImageFontAtlas(glyphs: *GlyphInfo, glyphRecs: **Rectangle, glyphCount: i32, fontSize: i32, padding: i32, packMethod: i32) -> Image // Generate image font atlas using chars info
pub ext fn UnloadFontData(glyphs: *GlyphInfo, glyphCount: i32) // Unload font chars info data (RAM)
pub ext fn UnloadFont(font: Font) // Unload font from GPU memory (VRAM)
pub ext fn ExportFontAsCode(font: Font, fileName: *u8) -> bool // Export font as code file, returns true on success

// Text drawing functions
pub ext fn DrawFPS(posX: i32, posY: i32) // Draw current FPS
pub ext fn DrawText(text: *u8, posX: i32, posY: i32, fontSize: i32, color: Color) // Draw text (using default font)
pub ext fn DrawTextEx(font: Font, text: *u8, position: Vector2, fontSize: f32, spacing: f32, tint: Color) // Draw text using font and additional parameters
pub ext fn DrawTextPro(font: Font, text: *u8, position: Vector2, origin: Vector2, rotation: f32, fontSize: f32, spacing: f32, tint: Color) // Draw text using Font and pro parameters (rotation)
pub ext fn DrawTextCodepoint(font: Font, codepoint: i32, position: Vector2, fontSize: f32, tint: Color) // Draw one character (codepoint)
pub ext fn DrawTextCodepoints(font: Font, codepoints: *i32, codepointCount: i32, position: Vector2, fontSize: f32, spacing: f32, tint: Color) // Draw multiple characters (codepoint)

// Text font info functions
pub ext fn SetTextLineSpacing(spacing: i32) // Set vertical line spacing when drawing with line-breaks
pub ext fn MeasureText(text: *u8, fontSize: i32) -> i32 // Measure string width for default font
pub ext fn MeasureTextEx(font: Font, text: *u8, fontSize: f32, spacing: f32) -> Vector2 // Measure string size for Font
pub ext fn MeasureTextCodepoints(font: Font, codepoints: *i32, length: i32, fontSize: f32, spacing: f32) -> Vector2 // Measure string size for an existing array of codepoints for Font
pub ext fn GetGlyphIndex(font: Font, codepoint: i32) -> i32 // Get glyph index position in font for a codepoint (unicode character), fallback to '?' if not found
pub ext fn GetGlyphInfo(font: Font, codepoint: i32) -> GlyphInfo // Get glyph font info data for a codepoint (unicode character), fallback to '?' if not found
pub ext fn GetGlyphAtlasRec(font: Font, codepoint: i32) -> Rectangle // Get glyph rectangle in font atlas for a codepoint (unicode character), fallback to '?' if not found

// Text codepoints management functions (unicode characters)
pub ext fn LoadUTF8(codepoints: *i32, length: i32) -> *u8 // Load UTF-8 text encoded from codepoints array
pub ext fn UnloadUTF8(text: *u8) // Unload UTF-8 text encoded from codepoints array
pub ext fn LoadCodepoints(text: *u8, count: *i32) -> *i32 // Load all codepoints from a UTF-8 text string, codepoints count returned by parameter
pub ext fn UnloadCodepoints(codepoints: *i32) // Unload codepoints data from memory
pub ext fn GetCodepointCount(text: *u8) -> i32 // Get total number of codepoints in a UTF-8 encoded string
pub ext fn GetCodepoint(text: *u8, codepointSize: *i32) -> i32 // Get next codepoint in a UTF-8 encoded string, 0x3f('?') is returned on failure
pub ext fn GetCodepointNext(text: *u8, codepointSize: *i32) -> i32 // Get next codepoint in a UTF-8 encoded string, 0x3f('?') is returned on failure
pub ext fn GetCodepointPrevious(text: *u8, codepointSize: *i32) -> i32 // Get previous codepoint in a UTF-8 encoded string, 0x3f('?') is returned on failure
pub ext fn CodepointToUTF8(codepoint: i32, utf8Size: *i32) -> *u8 // Encode one codepoint into UTF-8 byte array (array length returned as parameter)

// Text strings management functions (no UTF-8 strings, only byte chars)
// WARNING 1: Most of these functions use internal static buffers[], it's recommended to store returned data on user-side for re-use
// WARNING 2: Some functions allocate memory internally for the returned strings, those strings must be freed by user using MemFree()
pub ext fn LoadTextLines(text: *u8, count: *i32) -> **u8 // Load text as separate lines ('\n')
pub ext fn UnloadTextLines(text: **u8, lineCount: i32) // Unload text lines
pub ext fn TextCopy(dst: *u8, src: *u8) -> i32 // Copy one string to another, returns bytes copied
pub ext fn TextIsEqual(text1: *u8, text2: *u8) -> bool // Check if two text strings are equal
pub ext fn TextLength(text: *u8) -> u32 // Get text length, checks for '\0' ending
pub ext fn TextFormat(text: *u8, ...) -> *u8 // Text formatting with variables (sprintf() style)
pub ext fn TextSubtext(text: *u8, position: i32, length: i32) -> *u8 // Get a piece of a text string
pub ext fn TextRemoveSpaces(text: *u8) -> *u8 // Remove text spaces, concat words
pub ext fn GetTextBetween(text: *u8, begin: *u8, end: *u8) -> *u8 // Get text between two strings
pub ext fn TextReplace(text: *u8, search: *u8, replacement: *u8) -> *u8 // Replace text string with new string
pub ext fn TextReplaceAlloc(text: *u8, search: *u8, replacement: *u8) -> *u8 // Replace text string with new string, memory must be MemFree()
pub ext fn TextReplaceBetween(text: *u8, begin: *u8, end: *u8, replacement: *u8) -> *u8 // Replace text between two specific strings
pub ext fn TextReplaceBetweenAlloc(text: *u8, begin: *u8, end: *u8, replacement: *u8) -> *u8 // Replace text between two specific strings, memory must be MemFree()
pub ext fn TextInsert(text: *u8, insert: *u8, position: i32) -> *u8 // Insert text in a defined byte position
pub ext fn TextInsertAlloc(text: *u8, insert: *u8, position: i32) -> *u8 // Insert text in a defined byte position, memory must be MemFree()
pub ext fn TextJoin(textList: **u8, count: i32, delimiter: *u8) -> *u8 // Join text strings with delimiter
pub ext fn TextSplit(text: *u8, delimiter: u8, count: *i32) -> **u8 // Split text into multiple strings, using MAX_TEXTSPLIT_COUNT static strings
pub ext fn TextAppend(text: *u8, append: *u8, position: *i32) // Append text at specific position and move cursor
pub ext fn TextFindIndex(text: *u8, search: *u8) -> i32 // Find first text occurrence within a string, -1 if not found
pub ext fn TextToUpper(text: *u8) -> *u8 // Get upper case version of provided string
pub ext fn TextToLower(text: *u8) -> *u8 // Get lower case version of provided string
pub ext fn TextToPascal(text: *u8) -> *u8 // Get Pascal case notation version of provided string
pub ext fn TextToSnake(text: *u8) -> *u8 // Get Snake case notation version of provided string
pub ext fn TextToCamel(text: *u8) -> *u8 // Get Camel case notation version of provided string
pub ext fn TextToInteger(text: *u8) -> i32 // Get integer value from text
pub ext fn TextToFloat(text: *u8) -> f32 // Get float value from text

